generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Aspirasi {
  id        Int      @id @default(autoincrement())
  name      String
  nim       String
  email     String
  aspirasi  String
  createdAt DateTime @default(now())
}

model Mentor {
  id        Int    @id @default(autoincrement())
  name      String
  role      String
  imageUrl  String
  instagram String
  github    String
  linkedin  String
}

model Proker {
  id        Int      @id @default(autoincrement())
  dept      String
  title     String
  desc      String
  img       String
  createdAt DateTime @default(now())
}
