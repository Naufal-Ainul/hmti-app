// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma_client"
}

datasource db {
  provider = "postgresql"
}

model Aspirasi {
  id Int @id @default(autoincrement())
  name String
  nim String
  email String
  aspirasi String
  createdAt DateTime @default(now())
}

model Mentor {
  id Int @id @default(autoincrement())
  name String
  role String
  imageUrl String
  instagram String
  github String
  linkedin String
}

model Member {
  id         Int      @id @default(autoincrement())
  name       String
  role       String
  department String
  imageUrl   String
  instagram  String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}